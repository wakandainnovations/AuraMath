# =============================================================================
# config.secrets — host-side database registry for the AuraMath Ask engine
# =============================================================================
#
# Copy this to the home directory of the user running AuraMath and fill it in:
#
#     cp scripts/config.secrets.example ~/config.secrets
#     chmod 600 ~/config.secrets      # keep credentials readable only by you
#
# AuraMath reads this file ONCE at startup (path = aura.ask.secrets-path,
# default ~/config.secrets) and registers every database defined here. An Ask
# request then only needs a question (and optionally which databases to use) —
# credentials never travel in the request or live in the repo.
#
# Format: Java properties. Each database is one "ask.db.<name>.*" group, where
# <name> is the logical label you'll refer to it by (e.g. orders, billing).
# Supported drivers: postgresql, mysql, sqlite.
#
# Per-database fields:
#   url         (required)  JDBC URL — jdbc:postgresql:// | jdbc:mysql:// | jdbc:sqlite:
#   driver      (optional)  postgresql | mysql | sqlite (auto-detected from url if omitted)
#   username    (optional)  use a READ-ONLY account
#   password    (optional)
#   skipTables  (optional)  comma-separated tables to hide (e.g. audit_log,sessions)
#   skipColumns (optional)  comma-separated columns to hide (e.g. users.ssn,users.password)
# -----------------------------------------------------------------------------

# --- Example: a MySQL "orders" database --------------------------------------
ask.db.orders.driver=mysql
ask.db.orders.url=jdbc:mysql://localhost:3306/ordersdb
ask.db.orders.username=readonly_user
ask.db.orders.password=change_me
ask.db.orders.skipColumns=customers.ssn

# --- Example: a PostgreSQL "billing" database --------------------------------
ask.db.billing.driver=postgresql
ask.db.billing.url=jdbc:postgresql://localhost:5432/billing
ask.db.billing.username=readonly_user
ask.db.billing.password=change_me

# --- Example: a local SQLite file (no host/credentials) ----------------------
# ask.db.analytics.driver=sqlite
# ask.db.analytics.url=jdbc:sqlite:/var/data/analytics.db
